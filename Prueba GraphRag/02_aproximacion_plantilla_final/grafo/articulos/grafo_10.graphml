    <node id="FRAGMENTO::2-s2.0-85099940331::tipo_documental::3">
      <data key="d0">FRAGMENTO</data>
      <data key="d1">2-s2.0-85099940331::tipo_documental::3</data>
      <data key="d4">2-s2.0-85099940331::tipo_documental::3</data>
