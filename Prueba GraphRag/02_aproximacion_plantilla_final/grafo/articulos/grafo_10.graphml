    <node id="ARTICULO::2-s2.0-85099940331">
      <data key="d0">ARTICULO</data>
      <data key="d1">The Bibliometric Studies in the Field of Ibero-American Psychology: A Metabibliometric Review</data>
      <data key="d3">2-s2.0-85099940331</data>
    </node>
