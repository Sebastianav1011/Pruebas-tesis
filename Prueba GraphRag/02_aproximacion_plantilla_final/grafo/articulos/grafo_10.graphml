    <node id="ARTICULO::2-s2.0-85189898702">
      <data key="d0">ARTICULO</data>
      <data key="d1">Global burden of 288 causes of death and life expectancy decomposition in 204 countries and territories and 811 subnational locations, 1990–2021: a systematic analysis for the Global Burden of Disease Study 2021</data>
      <data key="d3">2-s2.0-85189898702</data>
    </node>
    <node id="FRAGMENTO::2-s2.0-85189898702::facultad::1">
      <data key="d0">FRAGMENTO</data>
      <data key="d1">2-s2.0-85189898702::facultad::1</data>
      <data key="d4">2-s2.0-85189898702::facultad::1</data>
