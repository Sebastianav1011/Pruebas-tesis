    <node id="FRAGMENTO::2-s2.0-105020034198::anio::5">
      <data key="d0">FRAGMENTO</data>
      <data key="d1">2-s2.0-105020034198::anio::5</data>
      <data key="d4">2-s2.0-105020034198::anio::5</data>
      <data key="d5">anio</data>
