    </node>
    <node id="FRAGMENTO::2-s2.0-105014099823::investigador_docente::4">
      <data key="d0">FRAGMENTO</data>
      <data key="d1">2-s2.0-105014099823::investigador_docente::4</data>
      <data key="d4">2-s2.0-105014099823::investigador_docente::4</data>
